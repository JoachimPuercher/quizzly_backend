# Copy this file to .env and fill in your own values.
# Generate a key with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me
DEBUG=True

# Lists are comma separated, without spaces and without a trailing comma.
ALLOWED_HOSTS=127.0.0.1,localhost

# Where the frontend runs. Needs scheme and port, no trailing slash.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

GEMINI_API_KEY=APIKEY

# Optional. Address of the PO token provider that lets yt-dlp download from a
# server IP. docker-compose.yml sets it for the container; leave it unset locally.
# YTDLP_POT_PROVIDER_URL=http://pot-provider:4416